# =============================================================================
# Free Games Claimer Remaster – settings
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Remove the '#' in front of every line you change and fill in your value.
# 3. Start it:         docker compose up -d
# Lines starting with '#' are ignored, and .env is never pushed to the repository.
# Every setting is described in full in README.md, section "Configuration".
# =============================================================================

# ── DOCKER ───────────────────────────────────────────────────────────────────
# Image to run: latest (stable, the default) or dev (pre-release builds).
# FGC_TAG=dev

# Run as your own user instead of root, numbers from `id -u` and `id -g` on the host.
# PUID=1000
# PGID=1000

# ── DISPLAY / VNC ────────────────────────────────────────────────────────────
# Browser window in VNC: 1 = shown, 0 = headless.
SHOW=1

# Size of the virtual screen.
WIDTH=1280
HEIGHT=720

# noVNC port: open http://localhost:7080 to watch the browser.
NOVNC_PORT=7080

# Address of your server or NAS for the VNC links in notifications (default localhost).
# VNC_IP=192.168.1.100

# Behind a reverse proxy: full public address, e.g. https://fgc.example.tld (replaces VNC_IP and port).
# VNC_URL=

# VNC password, empty = none.
# VNC_PASSWORD=

# Seconds to wait for you at a manual step (sign-in, code, captcha) before that store is skipped.
# VNC_LOGIN_TIMEOUT=180

# ── SCHEDULER  –  an interval, fixed daily times, or both ────────────────────
# Run every N hours, counted from startup. 0 = no interval runs.
# SCHEDULER_HOURS=12

# Timezone for the fixed times below (IANA name, e.g. Europe/Berlin).
# SCHEDULER_TIMEZONE=UTC

# Fixed daily run times, 24-hour HH:MM, comma-separated, e.g. 17:00,21:30.
# SCHEDULER_FIXED_TIMES=

# One run as soon as the container starts.
# RUN_ON_STARTUP=true

# Claim once, then exit (for cron or Ofelia). Needs restart: "no" in docker-compose.yml.
# RUN_ONCE=false

# ── NOTIFICATIONS  –  Discord and Apprise, both used when both are set ───────
# Discord: Server Settings → Integrations → Webhooks → New Webhook.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Apprise URLs, comma-separated, e.g. tgram://bottoken/ChatID, ntfy://topic (github.com/caronc/apprise).
# Own Apprise API: apprise://IP:PORT/your_config_code (apprises:// for HTTPS), never http:// or /cfg/.
# NOTIFY=

# Test message on every start, switch it off once it arrives.
# NOTIFY_TEST=false

# What gets sent, to Discord and Apprise alike:
# Summary after each run.
# NOTIFY_SUMMARY=true
# Crashes and fatal errors.
# NOTIFY_ERRORS=true
# Games and check-ins that could not be claimed, with the reason.
# NOTIFY_CLAIM_FAILS=true
# Games you already own, check-ins already collected, giveaways skipped on purpose.
# NOTIFY_ALREADY_CLAIMED=false
# DLC that needs a base game you do not own (repeats every run).
# NOTIFY_MISSING_BASE=true
# Itch.io giveaways that are only a download.
# NOTIFY_DOWNLOAD_ONLY=true
# A newer release of this bot on GitHub, once per version.
# NOTIFY_UPDATES=true
# Pings when you are needed in VNC.
# NOTIFY_LOGIN_REQUEST=true

# Stores to keep quiet (they still run), comma-separated, any name STORES takes (ae, ms, itchio).
# NOTIFY_SKIP_STORES=aliexpress

# ── DEFAULT LOGIN  –  for every store without a login of its own below ───────
# EMAIL=
# PASSWORD=

# ── EPIC GAMES  –  weekly free games (Fab signs in with the same account) ────
# EG_EMAIL=your@email.com
# EG_PASSWORD=your_password

# Authenticator secret ("manual entry key"), filled in for you. E-mail/SMS codes go over VNC.
# EG_OTP_KEY=

# Recovery codes, used after the secret. Spent ones are kept in data/used_epic_codes.txt.
# EG_OTP_CODES=CODE1,CODE2,CODE3

# Parental Controls PIN, if you use it.
# EG_PARENTALPIN=

# The weekly free mobile game too, and which versions.
# EG_MOBILE=true
# EG_MOBILE_PLATFORMS=android,ios

# ── PRIME GAMING (Amazon)  –  monthly free games ─────────────────────────────
# PG_EMAIL=your@email.com
# PG_PASSWORD=your_password

# Authenticator secret (Login & Security → 2-Step Verification → Authenticator App).
# PG_OTP_KEY=

# Check games already marked as claimed again.
# PG_FORCE_CHECK_COLLECTED=false

# ── GOG  –  giveaways, plus the GOG codes from Prime Gaming ──────────────────
# GOG_EMAIL=your@email.com
# GOG_PASSWORD=your_password

# Keep the GOG newsletter after a claim (false = unsubscribe).
# GOG_NEWSLETTER=false

# Redeem old GOG codes from Prime Gaming again, even ones already processed.
# GOG_FORCE_REDEEM=false

# Authenticator secret, filled in for you. E-mail codes go over VNC.
# GOG_OTP_KEY=

# Recovery codes, used after the secret. Spent ones are kept in data/used_gog_codes.txt.
# GOG_OTP_CODES=CODE1,CODE2,CODE3

# ── MICROSOFT  –  Prime Gaming codes and paid games while they are free ──────
# MS_EMAIL=your@email.com
# MS_PASSWORD=your_password

# Try Microsoft codes from the last 60 days again, even ones already tried.
# MS_FORCE_REDEEM=false

# Authenticator secret, filled in for you. E-mail codes and passkeys go over VNC.
# MS_OTP_KEY=

# ── STEAM  –  free-to-keep games ─────────────────────────────────────────────
# STEAM_USERNAME=your_username
# STEAM_PASSWORD=your_password

# ── FAB  –  free assets on your Epic account (opt-in: add fab to STORES) ─────
# Accept Fab's licence and the EU withdrawal waiver. false = stop and notify you instead.
# FAB_ACCEPT_EULA=true

# ── UNITY ASSET STORE  –  weekly free asset (opt-in: add unity to STORES) ────
# UNITY_EMAIL=your@email.com
# UNITY_PASSWORD=your_password

# Accept the Asset Store EULA and the 14-day withdrawal waiver. false = stop and notify you instead.
# UNITY_ACCEPT_TOS=true

# ── UBISOFT  –  free game giveaways (your Ubisoft Connect account) ───────────
# UBI_EMAIL=your@email.com
# UBI_PASSWORD=your_password

# Authenticator secret, filled in for you. E-mail codes go over VNC.
# UBI_OTP_KEY=your_totp_secret

# ── ALIEXPRESS  –  daily coin check-in ───────────────────────────────────────
# AE_EMAIL=your@email.com
# AE_PASSWORD=your_password

# Fewer coins than AE_MIN_COINS means a bot flag: no collecting, wait AE_FLAG_WAIT seconds
# (keep it above the ~420 s penalty) and look again, up to AE_FLAG_RETRIES times.
# AE_MIN_COINS=2
# AE_FLAG_RETRIES=3
# AE_FLAG_WAIT=480

# Extra approaches when the coin page loads empty. 0 = give up on the first look.
# AE_PAGE_RETRIES=4

# Country site for the coin page, e.g. it -> m.it.aliexpress.com. Empty = global m.aliexpress.com.
# Set it when the check-in lands on your country's home page instead of the coin page.
# AE_SITE=

# ── STORE SELECTION ──────────────────────────────────────────────────────────
# Stores to run, empty = the list below. Opt-in: fab, unity, itchio, fanatical, indiegala, alienware.
# GamerPower is asked on every run and its finds go to the stores named here.
# STORES=steam,epic,prime,gog,microsoft,ubisoft,aliexpress

# At startup, forget claims from the last 7 days (games wrongly marked as claimed).
# RESET_DB_GAMES=false

# ── GAMERPOWER SITES  –  only when named in STORES, each needs an account ────
# Also take in-game DLC giveaways (most need an account in that game).
# GP_CLAIM_DLC=false

# Fanatical (fanatical): the Steam key from a giveaway is activated on Steam when steam is in STORES.
# FANATICAL_EMAIL=your_fanatical@email.com
# FANATICAL_PASSWORD=your_password

# Alienware Arena (alienware): notify only, you claim the key yourself.

# Itch.io (itchio). Two-factor is optional: authenticator secret, recovery codes (spent ones
# in data/used_itchio_codes.txt), or you over VNC. See "Two-factor sign-in" in the README.
# ITCHIO_EMAIL=your_itchio@email.com
# ITCHIO_PASSWORD=your_password
# ITCHIO_OTP_KEY=
# ITCHIO_OTP_CODES=12345678,23456789,34567890

# IndieGala (indiegala): you tick the login captcha over VNC, the sign-in then lasts 14 days.
# INDIEGALA_EMAIL=your_indiegala@email.com
# INDIEGALA_PASSWORD=your_password

# Sites nobody mapped yet (e.g. MMOBomb): not built, stays off whatever you set.
# GP_UNKNOWN_STORES=false

# ── ADVANCED ─────────────────────────────────────────────────────────────────
# Browser profiles (keep you signed in between runs) and failure screenshots.
# BROWSER_DIR=data/browser
# SCREENSHOTS_DIR=data/screenshots

# Detailed log of what the bot does, on by default.
# DEBUG=true

# Library internals too (every CDP frame, HTTP, SQL). Only when a bug report asks for it.
# DEBUG_LIBS=false

# Find giveaways and report them without claiming anything.
# DRYRUN=false

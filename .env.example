# =============================================================================
# Free Games Claimer Remaster – Environment Configuration
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:          cp .env.example .env
#   2. Fill in your values below (uncomment lines by removing the '#')
#   3. Run:                     docker compose up -d --build
#
# The .env file is gitignored and will NOT be pushed to the repository.
# Lines starting with '#' are comments and are ignored.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# DOCKER IMAGE / VERSION  –  Select which container version to run
# ─────────────────────────────────────────────────────────────────────────────

# Docker image tag to pull when running 'docker compose up -d'.
# Defaults to 'latest' (stable production build).
# Uncomment and set to 'dev' if you want to test experimental pre-release features!
# FGC_TAG=dev


# ─────────────────────────────────────────────────────────────────────────────
# DISPLAY / VNC  –  Control the virtual browser window inside Docker
# ─────────────────────────────────────────────────────────────────────────────

# Show the browser window inside VNC (1 = yes, 0 = headless / no window)
SHOW=1

# Resolution of the virtual display inside Docker (default 1280x720)
WIDTH=1280
HEIGHT=720

# Advanced: seconds to wait for a page element before giving up (default 60)
# TIMEOUT=60

# Port to access noVNC web client (open http://localhost:7080 in your browser)
NOVNC_PORT=7080

# The IP address or Hostname displayed in Discord/Apprise notifications.
# When a manual action is needed, notifications include a one-click link:
#   http://<VNC_IP>:<NOVNC_PORT>/?autoconnect=true
# Change this if you run the bot on a remote server/NAS and 'localhost' doesn't work.
# VNC_IP=192.168.1.100

# Optional: Set a password for VNC access (empty = no password)
# VNC_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULER  –  How often the bot checks for new free games
# ─────────────────────────────────────────────────────────────────────────────
# You can run the bot on a recurring interval, at fixed daily clock times, or both.
# Note: By default, RUN_ON_STARTUP=true runs one check immediately when the
# container starts, before waiting for either scheduler trigger below.

# 1. INTERVAL RUNS: Run periodically every X hours counted from startup (default: 12).
# Accepts any positive number of hours (for example: 1, 12, 24, 48, 72).
# Set SCHEDULER_HOURS=0 to disable interval runs if you only want fixed daily times.
# SCHEDULER_HOURS=12

# 2. FIXED DAILY RUNS: Run every day at specific clock times (e.g. drop windows).
# Timezone used for fixed daily times (use an IANA name like Europe/Berlin or UTC).
# SCHEDULER_TIMEZONE=UTC

# Comma-separated daily run times in 24-hour HH:MM format (e.g.: 17:00,21:30).
# If you configure this and DO NOT want interval runs alongside it, set SCHEDULER_HOURS=0 above.
# SCHEDULER_FIXED_TIMES=

# Run once immediately when the application/container starts (default: true)
# RUN_ON_STARTUP=true


# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS  –  Get alerts when games are claimed or errors occur
# ─────────────────────────────────────────────────────────────────────────────
# Both Discord and Apprise can be configured simultaneously, notifications
# will be sent to ALL configured services in parallel.

# Discord webhook URL, the bot sends messages here about claimed games
# Create one in Discord: Server Settings → Integrations → Webhooks → New Webhook
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Apprise URL for Telegram, Slack, Email, ntfy, and 80+ other services.
# See https://github.com/caronc/apprise for supported services.
#
# Direct service examples:
#   NOTIFY=tgram://bottoken/ChatID
#   NOTIFY=ntfy://topic/
#   NOTIFY=slack://TokenA/TokenB/TokenC
#
# You can also specify multiple services separated by commas or spaces:
#   NOTIFY=ntfy://topic1, tgram://bottoken/ChatID
#
# Self-hosted Apprise API (local Docker instance / NAS / home server):
#   If your Apprise UI gives you a configuration link like:
#     http://[IP]:[PORT]/cfg/your_config_code
#   You MUST replace "http://" with "apprise://" and REMOVE "/cfg/":
#     NOTIFY=apprise://[IP]:[PORT]/your_config_code         (for HTTP)
#     NOTIFY=apprises://[IP]:[PORT]/your_config_code        (for HTTPS)
#   ⚠️ Using http:// or keeping /cfg/ will cause 404 errors!
#
# NOTIFY=

# Send a test notification on startup to verify your setup works.
# Set to true on first run, then disable it once confirmed (fires every restart).
# NOTIFY_TEST=false

# Fine-tune which notifications you receive (true = enabled, false = disabled):
# Note: These settings apply globally to ALL configured services (Discord AND Apprise)!
# NOTIFY_SUMMARY=true           # Summary of all claimed games after each run
# NOTIFY_ERRORS=true            # Critical errors / module crashes
# NOTIFY_CLAIM_FAILS=false      # Games that could not be claimed (e.g. DLC without the base game), also in the summary
# NOTIFY_ALREADY_CLAIMED=false  # Also list games you already own / check-ins already collected today
# NOTIFY_UPDATES=true           # Tell you once when a newer release of this bot is published on GitHub
# NOTIFY_LOGIN_REQUEST=true     # Alert when manual VNC login is needed

# Silence notifications from specific stores (they still run and claim).
# Comma-separated store keys; accepts aliases (ae, amazon, gp).
# Example: don't get the daily AliExpress summary:
# NOTIFY_SKIP_STORES=aliexpress


# ─────────────────────────────────────────────────────────────────────────────
# DEFAULT CREDENTIALS  –  Used by ALL stores unless overridden below
# ─────────────────────────────────────────────────────────────────────────────
# If you use the same email/password for every store, set them here.
# Store-specific values below will take priority over these defaults.

# EMAIL=
# PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# EPIC GAMES  –  Claims weekly free games from the Epic Games Store
# ─────────────────────────────────────────────────────────────────────────────

# EG_EMAIL=your@email.com
# EG_PASSWORD=your_password

# 2FA / MFA key (the "Manual Entry Key" from Epic's authenticator setup).
# Covers the AUTHENTICATOR (TOTP) method only, it is filled automatically.
# Email / SMS codes can't be automated: the bot detects the code screen and
# waits for you to type the code in the browser via VNC (it no longer loops).
# EG_OTPKEY=

# Parental Controls PIN (if you have it enabled on your Epic account)
# EG_PARENTALPIN=

# Epic's weekly free MOBILE game (claimed on the same store page as the PC games).
# EG_MOBILE=true
# Which mobile versions to claim, Android and iOS are separate items of the same game.
# EG_MOBILE_PLATFORMS=android,ios


# ─────────────────────────────────────────────────────────────────────────────
# PRIME GAMING (Amazon)  –  Claims monthly free games from Prime Gaming
# ─────────────────────────────────────────────────────────────────────────────

# PG_EMAIL=your@email.com
# PG_PASSWORD=your_password

# Amazon 2FA key (from "Login & Security → 2-Step Verification → Authenticator App")
# PG_OTPKEY=

# Force re-check games that are already marked as "claimed" in the database
# Useful if you suspect some were missed or codes were not extracted properly
# PG_FORCE_CHECK_COLLECTED=false

# Try to automatically redeem keys on external stores (experimental)
# PG_REDEEM=false

# Also try to claim DLCs, not just base games (experimental)
# PG_CLAIMDLC=false


# ─────────────────────────────────────────────────────────────────────────────
# GOG  –  Claims periodic free game giveaways from GOG.com
# ─────────────────────────────────────────────────────────────────────────────

# GOG_EMAIL=your@email.com
# GOG_PASSWORD=your_password

# Keep newsletter subscription after claiming (false = unsubscribe, true = keep)
# GOG_NEWSLETTER=false

# Force re-redeem old GOG codes from Prime Gaming even if already processed
# GOG_FORCE_REDEEM=false

# Automatically consume backup codes for GOG 2FA (if enabled)
# GOG_OTP_ENABLE=false
# GOG_OTP_CODES=CODE1,CODE2,CODE3

# ─────────────────────────────────────────────────────────────────────────────
# STEAM  –  Claims free-to-keep games from Steam
# ─────────────────────────────────────────────────────────────────────────────

# STEAM_USERNAME=your_username
# STEAM_PASSWORD=your_password

# ─────────────────────────────────────────────────────────────────────────────
# ALIEXPRESS  –  Verifies login & performs daily check-in on mobile coin page
# ─────────────────────────────────────────────────────────────────────────────

# AE_EMAIL=your@email.com
# AE_PASSWORD=your_password

# Anti-bot protection: when AliExpress flags the session it caps the daily
# check-in at 1 coin (instead of e.g. 70) for a fixed ~7-minute penalty.
# The bot will NOT collect when fewer than AE_MIN_COINS coins are offered –
# instead it waits AE_FLAG_WAIT seconds, re-approaches the coin page organically
# and checks again, up to AE_FLAG_RETRIES times, then collects the full amount
# once the penalty lifts.
# Keep AE_FLAG_WAIT above the ~7-min (420s) penalty so one wait clears it.
# AE_MIN_COINS=2
# AE_FLAG_RETRIES=3
# AE_FLAG_WAIT=480


# ─────────────────────────────────────────────────────────────────────────────
# MODULE SELECTION & ADVANCED
# ─────────────────────────────────────────────────────────────────────────────

# If empty, default stores (steam, epic, prime, gog, aliexpress) will run, EXCLUDING gamerpower.
# STORES=steam,epic,prime,gog,aliexpress

# Clear database memory for recent game claims upon startup.
# Useful if games were falsely marked as 'claimed' or 'already redeemed', 
# and you want the bot to try claiming them again.
# Set to 'true' to automatically delete all claims recorded in the last 7 days.
# RESET_DB_GAMES=false
# --- Fanatical Configuration (via GamerPower) ---
# Some GamerPower giveaways redirect to Fanatical.com.
# Fanatical giveaways require logging into Fanatical and having your Steam account linked globally!
# (To use Fanatical, make sure you ALSO ADD 'gamerpower' to your STORES list above!)
#
# FANATICAL_ENABLE=false
# FANATICAL_EMAIL=your_fanatical@email.com
# FANATICAL_PASSWORD=your_password

# --- Alienware Arena Configuration (via GamerPower) ---
# Many GamerPower giveaways redirect to alienwarearena.com for key retrieval.
# Since Alienware Arena requires ARP points to claim keys and uses heavy 
# CAPTCHAs, this module operates in **notify-only** mode. When enabled,
# you will receive a Discord/Apprise alert to claim the key manually.
#
# ALIENWARE_ENABLE=false

# --- Itch.io Configuration (via GamerPower) ---
# Some GamerPower giveaways redirect to itch.io for free game claiming.
# Requires a free itch.io account.
#
# ITCHIO_ENABLE=false
# ITCHIO_EMAIL=your_itchio@email.com
# ITCHIO_PASSWORD=your_password

# --- IndieGala Configuration (via GamerPower) ---
# Some GamerPower giveaways redirect to indiegala.com for free DRM-free games.
# Requires a free IndieGala account.
#
# INDIEGALA_ENABLE=false
# INDIEGALA_EMAIL=your_indiegala@email.com
# INDIEGALA_PASSWORD=your_password

# --- Other/Unknown Stores (via GamerPower) ---
# If a giveaway points to a site not explicitly supported above (e.g. MMOBomb),
# by default the bot skips it. Set to true if you want the bot to open these
# in the browser anyway (you will have to claim them manually via VNC).
#
# UNKNOWN_STORES_ENABLE=false


# Browser profile directory (stores cookies and session data between restarts)
# BROWSER_DIR=data/browser

# Directory where debug/failure screenshots are saved
# SCREENSHOTS_DIR=data/screenshots

# Enable verbose debug logging (shows every action the bot takes). On by default.
# DEBUG=true

# Add the internals of the libraries the bot uses (every CDP frame sent to Chrome,
# HTTP handshakes, SQL queries). Only useful when asked for it in a bug report.
# DEBUG_LIBS=false

# Dry run mode, detect available giveaways and send a summary report without claiming games
# DRYRUN=false
